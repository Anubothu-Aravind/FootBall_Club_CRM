import { useState, useEffect, useRef } from "react";
import { apiService, API_ENDPOINTS } from "../../services/api";
import { useAuth } from "../../context/AuthContext";

/**
 * JerseyLikesAnalytics Component
 * Displays analytics and management controls for jersey likes
 * Admin/Super Admin only
 */
const JerseyLikesAnalytics = () => {
  const { coach } = useAuth();
  const [analytics, setAnalytics] = useState(null);
  const [selectedJersey, setSelectedJersey] = useState(null);
  const [likeDetails, setLikeDetails] = useState(null);
  const [loading, setLoading] = useState(true);
  const [detailsLoading, setDetailsLoading] = useState(false);
  const [actionLoading, setActionLoading] = useState({});
  const [openDropdown, setOpenDropdown] = useState(null);
  const [confirmModal, setConfirmModal] = useState(null);
  const [expandedCards, setExpandedCards] = useState({});
  const dropdownRef = useRef(null);

  console.log("JerseyLikesAnalytics mounted");

  // Close dropdown when clicking outside
  useEffect(() => {
    const handleClickOutside = (event) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {
        setOpenDropdown(null);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  // Fetch analytics on mount
  useEffect(() => {
    console.log("Fetching analytics...");
    fetchAnalytics();
  }, []);

  const fetchAnalytics = async () => {
    setLoading(true);
    try {
      const response = await apiService.get(
        API_ENDPOINTS.JERSEY_LIKE_ANALYTICS,
      );
      if (response.success) {
        setAnalytics(response);
      } else {
        console.error("Failed to fetch analytics:", response);
        // Set empty analytics on failure
        setAnalytics({
          success: true,
          summary: {
            totalLikes: 0,
            totalAuthenticatedLikes: 0,
            totalAnonymousLikes: 0,
            totalJerseys: 0,
          },
          jerseys: [],
        });
      }
    } catch (error) {
      console.error("Failed to fetch analytics:", error);
      // Set empty analytics on error
      setAnalytics({
        success: true,
        summary: {
          totalLikes: 0,
          totalAuthenticatedLikes: 0,
          totalAnonymousLikes: 0,
          totalJerseys: 0,
        },
        jerseys: [],
      });
    } finally {
      setLoading(false);
    }
  };

  const fetchJerseyDetails = async (jerseyId) => {
    setDetailsLoading(true);
    try {
      const response = await apiService.get(
        API_ENDPOINTS.JERSEY_LIKE_DETAILS(jerseyId),
      );
      if (response.success) {
        setLikeDetails(response);
        setSelectedJersey(jerseyId);
      }
    } catch (error) {
      console.error("Failed to fetch jersey details:", error);
    } finally {
      setDetailsLoading(false);
    }
  };

  const handleReset = async (jerseyId) => {
    setConfirmModal({
      type: "reset",
      jerseyId,
      title: "Reset Jersey Likes",
      message:
        "Are you sure you want to reset all likes for this jersey? This will mark them as inactive but can be restored later.",
      confirmText: "Reset",
      confirmClass: "bg-yellow-600 hover:bg-yellow-700",
    });
  };

  const handleRestore = async (jerseyId) => {
    setConfirmModal({
      type: "restore",
      jerseyId,
      title: "Restore Jersey Likes",
      message:
        "Are you sure you want to restore all previously reset likes for this jersey?",
      confirmText: "Restore",
      confirmClass: "bg-green-600 hover:bg-green-700",
    });
  };

  const handleDelete = async (jerseyId) => {
    if (coach?.role !== "SUPER_ADMIN") {
      alert("Only Super Admins can permanently delete likes.");
      return;
    }

    setConfirmModal({
      type: "delete",
      jerseyId,
      title: "Permanently Delete Likes",
      message:
        "⚠️ WARNING: This will PERMANENTLY delete all likes for this jersey. This action cannot be undone and data cannot be recovered.",
      confirmText: "Delete Forever",
      confirmClass: "bg-red-600 hover:bg-red-700",
    });
  };

  const executeAction = async () => {
    if (!confirmModal) return;

    const { type, jerseyId } = confirmModal;
    setOpenDropdown(null);
    setConfirmModal(null);

    setActionLoading((prev) => ({ ...prev, [`${type}-${jerseyId}`]: true }));
    try {
      let response;
      if (type === "reset") {
        response = await apiService.post(
          API_ENDPOINTS.JERSEY_LIKE_RESET(jerseyId),
        );
      } else if (type === "restore") {
        response = await apiService.post(
          API_ENDPOINTS.JERSEY_LIKE_RESTORE(jerseyId),
        );
      } else if (type === "delete") {
        response = await apiService.delete(
          API_ENDPOINTS.JERSEY_LIKE_DELETE(jerseyId),
        );
      }

      if (response?.success) {
        alert(response.message);
        await fetchAnalytics();
        if (selectedJersey === jerseyId) {
          if (type === "delete") {
            setSelectedJersey(null);
            setLikeDetails(null);
          } else {
            await fetchJerseyDetails(jerseyId);
          }
        }
      }
    } catch (error) {
      console.error(`Failed to ${type} likes:`, error);
      alert(`Failed to ${type} likes. Please try again.`);
    } finally {
      setActionLoading((prev) => ({ ...prev, [`${type}-${jerseyId}`]: false }));
    }
  };

  const formatDate = (dateString) => {
    if (!dateString) return "N/A";
    return new Date(dateString).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  };

  if (loading) {
    return (
      <div className="flex justify-center items-center py-12">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-orange-600"></div>
      </div>
    );
  }
  if (!analytics) {
    return (
      <div className="text-center py-12">
        <p className="text-gray-500">
          Failed to load analytics. Please refresh the page.
        </p>
      </div>
    );
  }
  return (
    <div className="space-y-8">
      {/* Summary Cards */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div className="bg-gradient-to-br from-orange-500 to-red-600 text-white rounded-lg p-6 shadow-lg">
          <div className="flex items-center justify-between mb-2">
            <h3 className="text-sm font-semibold uppercase tracking-wide">
              Total Likes
            </h3>
            <svg
              className="w-8 h-8 opacity-80"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <p className="text-4xl font-bold">
            {analytics?.summary?.totalLikes?.toLocaleString() || 0}
          </p>
        </div>

        <div className="bg-white border-2 border-blue-200 rounded-lg p-6 shadow-lg">
          <div className="flex items-center justify-between mb-2">
            <h3 className="text-sm font-semibold uppercase tracking-wide text-gray-600">
              Authenticated
            </h3>
            <svg
              className="w-8 h-8 text-blue-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              />
            </svg>
          </div>
          <p className="text-4xl font-bold text-gray-900">
            {analytics?.summary?.totalAuthenticatedLikes?.toLocaleString() || 0}
          </p>
        </div>

        <div className="bg-white border-2 border-purple-200 rounded-lg p-6 shadow-lg">
          <div className="flex items-center justify-between mb-2">
            <h3 className="text-sm font-semibold uppercase tracking-wide text-gray-600">
              Anonymous
            </h3>
            <svg
              className="w-8 h-8 text-purple-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <p className="text-4xl font-bold text-gray-900">
            {analytics?.summary?.totalAnonymousLikes?.toLocaleString() || 0}
          </p>
        </div>

        <div className="bg-white border-2 border-green-200 rounded-lg p-6 shadow-lg">
          <div className="flex items-center justify-between mb-2">
            <h3 className="text-sm font-semibold uppercase tracking-wide text-gray-600">
              Total Jerseys
            </h3>
            <svg
              className="w-8 h-8 text-green-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              />
            </svg>
          </div>
          <p className="text-4xl font-bold text-gray-900">
            {analytics?.summary?.totalJerseys || 0}
          </p>
        </div>
      </div>

      {/* Jersey List */}
      <div className="bg-white rounded-lg shadow-lg overflow-hidden">
        <div className="px-6 py-4 bg-gradient-to-r from-orange-600 to-red-600 border-b">
          <h2 className="text-xl font-bold text-white">Jersey Like Details</h2>
        </div>

        <div className="overflow-x-auto">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-gray-50">
              <tr>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Jersey
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Season
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Total Likes
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Authenticated
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Anonymous
                </th>
                <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Last Like
                </th>
                <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-200">
              {analytics?.jerseys?.map((jersey) => (
                <tr
                  key={jersey._id}
                  className="hover:bg-gray-50 transition-colors"
                >
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="flex items-center">
                      <div className="flex-shrink-0 h-10 w-10 bg-red-100 rounded-full flex items-center justify-center">
                        <svg
                          className="w-6 h-6 text-red-600"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                      </div>
                      <div className="ml-4">
                        <div className="text-sm font-bold text-gray-900">
                          {jersey.jerseyDetails?.season || jersey._id}
                        </div>
                        <div
                          className="text-xs text-gray-400 font-mono truncate max-w-[140px]"
                          title={jersey._id}
                        >
                          {jersey._id}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <div className="text-sm text-gray-900">
                      {jersey.jerseyDetails?.season || "N/A"}
                    </div>
                    <div className="text-xs text-gray-500">
                      {jersey.jerseyDetails?.colorway || ""}
                    </div>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                      {jersey.totalLikes.toLocaleString()}
                    </span>
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {jersey.authenticatedLikes.toLocaleString()}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    {jersey.anonymousLikes.toLocaleString()}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {formatDate(jersey.lastLikeAt)}
                  </td>
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                    <button
                      onClick={() => fetchJerseyDetails(jersey._id)}
                      className="text-blue-600 hover:text-blue-900 transition-colors"
                      disabled={detailsLoading && selectedJersey === jersey._id}
                    >
                      View Details
                    </button>
                    <button
                      onClick={() => handleReset(jersey._id)}
                      disabled={actionLoading[`reset-${jersey._id}`]}
                      className="text-yellow-600 hover:text-yellow-900 transition-colors disabled:opacity-50"
                    >
                      {actionLoading[`reset-${jersey._id}`]
                        ? "Resetting..."
                        : "Reset"}
                    </button>
                    <button
                      onClick={() => handleRestore(jersey._id)}
                      disabled={actionLoading[`restore-${jersey._id}`]}
                      className="text-green-600 hover:text-green-900 transition-colors disabled:opacity-50"
                    >
                      {actionLoading[`restore-${jersey._id}`]
                        ? "Restoring..."
                        : "Restore"}
                    </button>
                    {coach?.role === "SUPER_ADMIN" && (
                      <button
                        onClick={() => handleDelete(jersey._id)}
                        disabled={actionLoading[`delete-${jersey._id}`]}
                        className="text-red-600 hover:text-red-900 transition-colors disabled:opacity-50"
                      >
                        {actionLoading[`delete-${jersey._id}`]
                          ? "Deleting..."
                          : "Delete"}
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {!analytics?.jerseys?.length && (
          <div className="text-center py-12">
            <p className="text-gray-500">No jersey likes found.</p>
          </div>
        )}
      </div>

      {/* Like Details Modal */}
      {selectedJersey && likeDetails && (
        <div className="bg-white rounded-lg shadow-lg overflow-hidden">
          <div className="px-6 py-4 bg-gradient-to-r from-blue-600 to-purple-600 border-b flex justify-between items-center">
            <h3 className="text-xl font-bold text-white">
              Like Details: {selectedJersey}
            </h3>
            <button
              onClick={() => {
                setSelectedJersey(null);
                setLikeDetails(null);
              }}
              className="text-white hover:text-gray-200 transition-colors"
            >
              <svg
                className="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2}
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>

          <div className="p-6">
            <div className="mb-4">
              <p className="text-sm text-gray-600">
                Total Likes:{" "}
                <span className="font-bold text-gray-900">
                  {likeDetails.totalLikes}
                </span>
              </p>
              <p className="text-sm text-gray-600">
                Showing:{" "}
                <span className="font-bold text-gray-900">
                  {likeDetails.count}
                </span>{" "}
                records
              </p>
            </div>

            <div className="overflow-x-auto max-h-96 overflow-y-auto">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-50 sticky top-0">
                  <tr>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      User
                    </th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      Email
                    </th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      Status
                    </th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      Liked At
                    </th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      IP Address
                    </th>
                    <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
                      Device
                    </th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {likeDetails.likes.map((like) => (
                    <tr key={like.id} className="hover:bg-gray-50">
                      <td className="px-4 py-3 text-sm">
                        {like.userName || "Anonymous"}
                      </td>
                      <td className="px-4 py-3 text-sm">
                        {like.userEmail || "N/A"}
                      </td>
                      <td className="px-4 py-3 text-sm">
                        <span
                          className={`px-2 py-1 rounded-full text-xs font-semibold ${
                            like.isActive
                              ? "bg-green-100 text-green-800"
                              : "bg-red-100 text-red-800"
                          }`}
                        >
                          {like.isActive ? "Active" : "Inactive"}
                        </span>
                      </td>
                      <td className="px-4 py-3 text-sm text-gray-600">
                        {formatDate(like.likedAt)}
                      </td>
                      <td className="px-4 py-3 text-sm text-gray-600 font-mono">
                        {like.ipAddress || "N/A"}
                      </td>
                      <td className="px-4 py-3 text-sm text-gray-600">
                        {like.metadata?.deviceType || "Unknown"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default JerseyLikesAnalytics;
