# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5001
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGO_URI=your_mongodb_connection_string_here
DB_NAME=footballapp

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=generate_a_secure_random_string_minimum_64_characters
BCRYPT_SALT_ROUNDS=10

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_specific_password
EMAIL_FROM=Your App Name <your_email@gmail.com>

# ============================================
# FRONTEND URLS
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# PASSWORD RESET CONFIGURATION
# ============================================
PASSWORD_RESET_TOKEN_EXPIRY=900000        # 15 minutes in ms
RATE_LIMIT_WINDOW=900000                  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=3

# ============================================
# OTP CONFIGURATION (for password change)
# ============================================
OTP_EXPIRY=600000                         # 10 minutes in milliseconds
OTP_LENGTH=6                              # 6-character alphanumeric OTP
OTP_MAX_ATTEMPTS=3                        # Maximum verification attempts
OTP_RATE_LIMIT_WINDOW=900000              # 15 minutes
OTP_RATE_LIMIT_MAX_REQUESTS=5             # Max OTP requests per window

# ============================================
# CRITICAL ALERT CONFIGURATION
# ============================================
CRITICAL_ALERTS_ENABLED=true              # Set to "true" to enable email alerts for critical actions

# ============================================
# CLOUDINARY (Image Storage)
# ============================================
# Required for image uploads via Cloudinary.
# Leave empty to use URL-based storage only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# AZURE DEPLOYMENT (Optional)
# All Azure features disabled by default.
# Set AZURE_ENABLED=true to activate Azure services.
# ============================================
AZURE_ENABLED=false

# Azure Cosmos DB (MongoDB API) — replaces MONGO_URI
AZURE_COSMOS_URI=

# Azure Blob Storage — replaces Cloudinary
AZURE_BLOB_CONNECTION=
AZURE_BLOB_CONTAINER=images

# Azure Communication Services — replaces SMTP
AZURE_EMAIL_CONNECTION=
AZURE_EMAIL_SENDER=noreply@yourdomain.com

# Azure Application Insights — monitoring
AZURE_APPINSIGHTS_KEY=
